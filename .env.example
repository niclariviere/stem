# STEM — local environment template.
# Copy to .env (which is gitignored) and fill in the values.

# ── Database ─────────────────────────────────────────────────────────────────
# Local self-hosted MySQL on the Mac Mini. Replace user/pass if needed.
DATABASE_URL=mysql://root@localhost:3306/stem

# ── Session signing ──────────────────────────────────────────────────────────
# Used to sign JWT session cookies. MUST be a long random string. Generate with:
#   openssl rand -hex 48
JWT_SECRET=

# ── Site URL ─────────────────────────────────────────────────────────────────
# Origin used in magic-link URLs and SIWS messages.
# In dev: http://localhost:3001
# In prod: https://stem.nixmusic.net
SITE_URL=http://localhost:3001

# ── Admins ───────────────────────────────────────────────────────────────────
# Comma-separated list of emails promoted to admin on first magic-link sign-in.
ADMIN_EMAILS=niclariviere@gmail.com

# ── Pinata IPFS ──────────────────────────────────────────────────────────────
# Used by the stem upload flow. Leave empty to fall back to a simulated CID.
# Note: VITE_ prefix exposes this to client-side code. Acceptable for trio
# phase; move IPFS upload to a server-side /api/ipfs/upload proxy before any
# wider rollout so the JWT stops leaking into the client bundle.
VITE_PINATA_JWT=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# STEM uses 3001 because Arbistar already holds 3000 on Nic's Mac Mini.
PORT=3001
